{
  "name": "po-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "企业采购订单采集工作台",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/check-node.mjs",
    "test": "vitest run",
    "pretest:watch": "node scripts/check-node.mjs",
    "test:watch": "vitest",
    "skill:install": "bash scripts/install-skill.sh",
    "skill:uninstall": "bash scripts/install-skill.sh --uninstall"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "adm-zip": "^0.5.18",
    "antd": "6.7.1",
    "better-sqlite3": "^11.10.0",
    "cheerio": "^1.2.0",
    "express": "^4.22.3",
    "p-limit": "^6.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.25",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.2.5",
    "jsdom": "^26.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^6.2.5",
    "vitest": "^3.0.5"
  }
}
